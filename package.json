    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "^30.1.3",
    "knip": "6.43.0",
    "pptxgenjs": "4.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
