{
  "name": "@ruxex/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "ladle:serve": "ladle serve",
    "check:catalog": "node scripts/check-ladle-component-stories.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint",
    "build": "vite build",
    "test": "vitest run",
    "format": "biome format --write .",
    "format:check": "biome format --changed --since=origin/main",
    "lint": "pnpm lint:biome && pnpm lint:react",
    "lint:biome": "biome lint .",
    "lint:react": "eslint src --max-warnings 0",
    "knip": "knip",
    "lint:fix": "biome lint --write . && eslint src --fix",
    "preview": "vite preview",
    "tauri": "tauri",
    "stage:runtime": "python3 scripts/stage-ruxex-package.py"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@milkdown/react": "^7.23.0",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-query": "^5.90.0",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-deep-link": "2.4.0",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-notification": "2.4.0",
    "@tauri-apps/plugin-opener": "2.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.21.0",
    "react-router-dom": "^7.9.0",
    "streamdown": "^2.7.1"
